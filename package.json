{
    "name":  "sentinel-pro",
    "version":  "0.1.0",
    "private":  true,
    "scripts":  {
                    "dev":  "node scripts/run-with-system-ca.mjs node node_modules/next/dist/bin/next dev",
                    "build":  "next build",
                    "start":  "node scripts/run-with-system-ca.mjs node node_modules/next/dist/bin/next start",
                    "lint":  "eslint .",
                    "typecheck":  "tsc --noEmit",
                    "test":  "vitest run --exclude=integrations/persistence/mongodb/** && vitest run --config vitest.mongodb.config.ts",
                    "test:watch":  "vitest",
                    "test:coverage":  "vitest run --coverage",
                    "migrate:identity":  "node scripts/run-with-system-ca.mjs node --experimental-strip-types integrations/persistence/mongodb/migrate.ts",
                    "migrate:catalog":  "node scripts/run-with-system-ca.mjs node --experimental-strip-types integrations/persistence/mongodb/catalog-migrate.ts",
                    "seed:identity":  "node scripts/run-with-system-ca.mjs node scripts/identity-seed.mjs",
                    "benchmark:argon2id":  "node benchmarks/argon2id.mjs"
                },
    "dependencies":  {
                         "argon2":  "^0.44.0",
                         "leaflet":  "^1.9.4",
                         "mongodb":  "^6.20.0",
                         "next":  "16.2.10",
                         "react":  "19.2.4",
                         "react-dom":  "19.2.4",
                         "react-leaflet":  "^5.0.0",
                         "supercluster":  "8.0.1"
                     },
    "devDependencies":  {
                            "@tailwindcss/postcss":  "^4",
                            "@testing-library/dom":  "^10.4.1",
                            "@testing-library/jest-dom":  "^6.9.1",
                            "@testing-library/react":  "^16.3.0",
                            "@types/leaflet":  "^1.9.21",
                            "@types/node":  "^20",
                            "@types/react":  "^19",
                            "@types/react-dom":  "^19",
                            "@types/supercluster":  "7.1.3",
                            "@vitest/coverage-v8":  "^4.0.7",
                            "eslint":  "^9",
                            "eslint-config-next":  "16.2.10",
                            "jsdom":  "^27.0.1",
                            "mongodb-memory-server":  "^10.1.4",
                            "tailwindcss":  "^4",
                            "typescript":  "^5",
                            "vitest":  "^4.0.7"
                        }
}
