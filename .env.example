# Milliseconds since a device's last GPS report before its vehicle is
# considered offline by domain/live/vehicle-status.ts's resolveVehicleStatus.
#
# Read by app/live/live-runtime-config.ts. Howen credentials below are read
# separately by integrations/howen/config.ts. Both boundaries are server-side.
#
# Optional. If unset, empty, non-numeric, negative, or zero, the app falls
# back to domain/live's DEFAULT_STALE_AFTER_MS (5 minutes) and — except when
# simply unset — logs a warning so a malformed value doesn't go unnoticed.
SENTINEL_LIVE_STALE_AFTER_MS=300000

# Required server-only Howen connection settings. The password must be raw;
# integrations/howen/session.ts hashes it for login.
HOWEN_BASE_URL=
HOWEN_USERNAME=
HOWEN_PASSWORD=

# Optional request timeout in milliseconds.
HOWEN_TIMEOUT_MS=15000

# Required server-only Cybermapa connection settings, read by
# integrations/cybermapa/config.ts. The password is sent raw in the request
# body per the documented GETVEHICULOS contract; unlike Howen, Cybermapa
# does not specify client-side hashing.
CYBERMAPA_API_URL=
CYBERMAPA_USER=
CYBERMAPA_PASSWORD=

# Optional request timeout in milliseconds.
CYBERMAPA_TIMEOUT_MS=15000

# Required server-only MongoDB connection settings for identity persistence.
SENTINEL_MONGODB_URI=
SENTINEL_MONGODB_DATABASE=sentinel_pro

# Required server-only secret compared with a constant-time Bearer check at
# POST /api/internal/catalog/synchronize (the catalog sync cron endpoint), by
# integrations/security/authorize-internal-secret.ts. Never logged or
# returned in any response.
SENTINEL_CATALOG_SYNC_SECRET=

# Required only when explicitly running the initial identity seed command.
SENTINEL_INITIAL_ORGANIZATION_NAME=
SENTINEL_INITIAL_ADMIN_EMAIL=
SENTINEL_INITIAL_ADMIN_PASSWORD=
SENTINEL_INITIAL_ADMIN_FIRST_NAME=Administrator
SENTINEL_INITIAL_ADMIN_LAST_NAME=Sentinel
